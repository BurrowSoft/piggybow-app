<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- A release build reaches the network for one thing only: pig tips,
         once the person turns them on (lib/tips/tips_http.dart, the only code
         that opens a connection: release_no_network_test). INTERNET comes from
         the main manifest. ACCESS_NETWORK_STATE, from Play Billing's logging
         library, stays out: dart:io doesn't need it, and Plus is off. Debug
         and profile builds keep the network for the Flutter tool (src/debug,
         src/profile). app/build.gradle.kts still fails a release build that
         sets SENTRY_DSN or PLUS_ENABLED until this file and the store's texts
         change too. -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
</manifest>
