<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9 to 11: the journal and the app's settings, and only in a
     backup encrypted on the phone (decision 72). Android 12+ reads
     data_extraction_rules.xml; Android 8 and below, xml/backup_rules.xml. -->
<full-backup-content>
    <include domain="file" path="journal.db" requireFlags="clientSideEncryption" />
    <include domain="sharedpref" path="FlutterSharedPreferences.xml" requireFlags="clientSideEncryption" />
</full-backup-content>
