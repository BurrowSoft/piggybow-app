<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen shortcut (a long press on the icon): "Add a spend" opens
     the app on Home with the Add sheet on Spent (MainActivity.kt, then
     lib/core/launch_actions.dart). The prod flavour's copy; dev and staging have their own (src/dev, src/staging), since the target package differs. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add_spend"
        android:enabled="true"
        android:icon="@drawable/ic_shortcut_add"
        android:shortcutShortLabel="@string/shortcut_add_short"
        android:shortcutLongLabel="@string/shortcut_add_long">
        <intent
            android:action="com.burrowsoft.piggybow.action.ADD_SPEND"
            android:targetPackage="com.burrowsoft.piggybow"
            android:targetClass="com.burrowsoft.piggybow.MainActivity" />
    </shortcut>
</shortcuts>
