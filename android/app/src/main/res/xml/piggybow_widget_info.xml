<?xml version="1.0" encoding="utf-8"?>
<!-- The home-screen widget (feature 16): 2×1 to as wide as the home screen,
     added at 3×2; home screen only, never the lock screen; no periodic
     updates (widget/PiggybowWidget.kt draws it when there's something new). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:description="@string/widget_description"
    android:initialLayout="@layout/widget_wide"
    android:minWidth="110dp"
    android:minHeight="40dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="40dp"
    android:previewLayout="@layout/widget_wide"
    android:resizeMode="horizontal|vertical"
    android:targetCellWidth="3"
    android:targetCellHeight="2"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
