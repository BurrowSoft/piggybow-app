<?xml version="1.0" encoding="utf-8"?>
<!-- Debug builds only: cleartext to the Android emulator's host, 10.0.2.2,
     for the tester's mock tips server (TIPS_TEST_URL, staging debug only).
     Everything else stays HTTPS only, and release and profile builds have no
     such file. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
    </domain-config>
</network-security-config>
